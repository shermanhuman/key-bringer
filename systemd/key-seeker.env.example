# Key Seeker Configuration
# Copy to /etc/key-seeker/env

# key-bringer server URL (Cloud Run)
SERVER_URL=https://key-bringer-xxxxx-uc.a.run.app

# Machine identifier
MACHINE_ID=ny1

# Optional defense-in-depth header value.
# Only set this if you can provide it securely at boot without creating a new
# "secret at rest on hosts" problem.
# Do not use Secret Manager aliases like "latest"; pin numeric versions.
AGENT_SECRET=

# ZFS dataset to unlock
ZFS_DATASET=tank/encrypted
