# Key Seeker Configuration
# Copy to /etc/key-seeker/env

# key-bringer server URL (Cloud Run)
SERVER_URL=https://key-bringer-xxxxx-uc.a.run.app

# Machine identifier
MACHINE_ID=ny1

# Agent secret (from: gcloud secrets versions access latest --secret=agent-secret)
AGENT_SECRET=your-agent-secret-here

# ZFS dataset to unlock
ZFS_DATASET=tank/encrypted
