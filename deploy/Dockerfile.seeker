# Build stage for key-seeker (host agent)
FROM golang:1.25-bookworm AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Build for Linux AMD64 (Debian Trixie)
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /key-seeker ./cmd/key-seeker

# Minimal runtime with ZFS tools
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    zfsutils-linux \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /key-seeker /usr/local/bin/key-seeker

ENTRYPOINT ["/usr/local/bin/key-seeker"]
