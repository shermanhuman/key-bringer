# Environment Variables for key-bringer
# Copy this file to .env and fill in your values

# Agent Authentication
AGENT_SECRET=SECRET_REDACTED

# TOTP
TOTP_SEED=SEED_REDACTED

# ZFS
ZFS_KEY=KEY_REDACTED
ZFS_DATASET=tank/encrypted

# Telnyx
TELNYX_API_KEY=KEY_REDACTED
TELNYX_FROM_NUMBER=+15555550123
TELNYX_PUBLIC_KEY=your-public-key-for-webhook-verification
ADMIN_PHONE=+15555550123

# Webhook path token (rotate before going to production)
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
WEBHOOK_PATH_TOKEN=TOKEN_REDACTED
# Optional: during rotation, set previous token and timestamp for 60s overlap
WEBHOOK_PATH_TOKEN_PREVIOUS=
WEBHOOK_PATH_TOKEN_PREVIOUS_VALID_UNTIL=

# Server
PORT=8080
