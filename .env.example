# Environment Variables for key-bringer
# Copy this file to .env and fill in your values

# Agent Authentication
AGENT_SECRET=SECRET_REDACTED

# TOTP
TOTP_SEED=SEED_REDACTED

# ZFS
ZFS_KEY=KEY_REDACTED
ZFS_DATASET=tank/encrypted

# Telnyx
TELNYX_API_KEY=KEY_REDACTED
TELNYX_FROM_NUMBER=+15555550123
TELNYX_PUBLIC_KEY=your-public-key-for-webhook-verification
TELNYX_MESSAGING_PROFILE_ID=your-messaging-profile-id
ADMIN_PHONE=+15555550123

# Public URL (Cloud Run service URL) used to build the Telnyx webhook URL.
PUBLIC_URL=https://key-bringer-xxxxx-uc.a.run.app

# Webhook path tokens are generated and rotated at runtime (in-memory).
# Do not set long-lived webhook tokens in env vars.

# Server
PORT=8080
